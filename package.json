{
  "name": "cortico-world-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "Cortico World: connects Model Context Protocol servers and lets the bot use their tools through one stable gateway",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "cortico-world",
    "cortico",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/UnusWhite/cortico-world-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnusWhite/cortico-world-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/UnusWhite/cortico-world-mcp/issues"
  },
  "author": "UnusWhite",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "MCP",
    "tags": [
      "unsafe",
      "internet"
    ],
    "locales": {
      "zh": {
        "displayName": "MCP",
        "description": "把 Model Context Protocol 服务器接进来，交给 bot 一组固定的工具：列服务器、列工具、调工具。能做什么取决于配置了哪些服务器。"
      }
    },
    "describe": "describe.json"
  },
  "files": [
    "src",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
